{
  "$schema": "https://typedoc.org/schema.json",
  "name": "MasterSeed TypeScript SDK",
  "entryPoints": ["../typescript/src/index.ts"],
  "entryPointStrategy": "resolve",
  "tsconfig": "typedoc-tsconfig.json",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "theme": "default",
  "out": "site/api/typescript",
  "docsRoot": "site",
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "disableSources": true,
  "includeVersion": true,
  "categorizeByGroup": true,
  "sort": ["source-order"],
  "validation": {"notExported": true, "invalidLink": true, "notDocumented": false},
  "sidebar": {"autoConfiguration": true, "format": "vitepress", "pretty": true, "collapsed": true}
}
